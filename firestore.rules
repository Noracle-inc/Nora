rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function boundedString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    match /users/{uid}/profile/current {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['name', 'greeting', 'pronouns', 'bio', 'focus', 'updatedAt'])
        && (!('name' in request.resource.data) || boundedString(request.resource.data.name, 80))
        && (!('greeting' in request.resource.data) || boundedString(request.resource.data.greeting, 160))
        && (!('pronouns' in request.resource.data) || boundedString(request.resource.data.pronouns, 40))
        && (!('bio' in request.resource.data) || boundedString(request.resource.data.bio, 1000))
        && (!('focus' in request.resource.data) || boundedString(request.resource.data.focus, 300))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow delete: if owns(uid);
    }

    match /users/{uid}/preferences/current {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'theme', 'language', 'notifications', 'privacyMode', 'reminders', 'reducedMotion', 'memory', 'updatedAt'
        ])
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['light-starry', 'dusk', 'gold'])
        && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'pcm', 'yo', 'ig', 'ha'])
        && (!('notifications' in request.resource.data) || request.resource.data.notifications is bool)
        && (!('privacyMode' in request.resource.data) || request.resource.data.privacyMode in ['private', 'standard'])
        && (!('reminders' in request.resource.data) || request.resource.data.reminders is bool)
        && (!('reducedMotion' in request.resource.data) || request.resource.data.reducedMotion is bool)
        && (!('memory' in request.resource.data) || request.resource.data.memory is bool)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow delete: if owns(uid);
    }

    match /users/{uid}/journals/{entryId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['title', 'text', 'createdAt'])
        && boundedString(request.resource.data.title, 120)
        && boundedString(request.resource.data.text, 10000)
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid}/moods/{entryId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['mood', 'note', 'createdAt'])
        && request.resource.data.mood in ['very-low', 'low', 'okay', 'good', 'very-good']
        && boundedString(request.resource.data.note, 1000)
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid}/conversations/{conversationId} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['title', 'messageCount', 'createdAt', 'updatedAt'])
        && boundedString(request.resource.data.title, 120)
        && request.resource.data.messageCount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly(['title', 'messageCount', 'createdAt', 'updatedAt'])
        && boundedString(request.resource.data.title, 120)
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 0
        && request.resource.data.messageCount <= 100
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      match /messages/{messageId} {
        allow read, delete: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly(['role', 'content', 'sequence', 'createdAt'])
          && request.resource.data.role in ['user', 'assistant']
          && boundedString(request.resource.data.content, 8000)
          && request.resource.data.content.size() > 0
          && request.resource.data.sequence is int
          && request.resource.data.sequence >= 1
          && request.resource.data.sequence <= 100
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
      }
    }
  }
}
